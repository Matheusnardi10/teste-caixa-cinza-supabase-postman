{
  "info": {
    "_postman_id": "68e673ef-d344-48ca-9d55-d3df7b781d59",
    "name": "Testes Caixa Cinza - Auth Supabase",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "59390135",
    "_collection_link": "https://go.postman.co/collection/59390135-68e673ef-d344-48ca-9d55-d3df7b781d59?source=collection_link"
  },
  "item": [
    {
      "name": "Login Válido",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code é 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Resposta contém access_token\", function () {\r\n    var jsonData = pm.response.json();\r\n    pm.expect(jsonData).to.have.property(\"access_token\");\r\n    pm.environment.set(\"access_token\", jsonData.access_token);\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "apikey",
            "value": "{{api_key}}"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{api_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"email\": \"{{email}}\",\r\n  \"password\": \"{{password}}\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/auth/v1/token?grant_type=password",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "v1",
            "token"
          ],
          "query": [
            {
              "key": "grant_type",
              "value": "password"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Credenciais Inválidas",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code é 400 (erro esperado)\", function () {\r\n    pm.response.to.have.status(400);\r\n});\r\n\r\npm.test(\"Mensagem de erro é 'Invalid login credentials'\", function () {\r\n    var jsonData = pm.response.json();\r\n    pm.expect(jsonData.msg).to.include(\"Invalid login credentials\");\r\n});"
            ]
